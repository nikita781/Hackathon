APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hackathon
DB_USERNAME=postgres
DB_PASSWORD=

MAIN_DB_CONNECTION=pgsql
MAIN_DB_HOST=127.0.0.1
MAIN_DB_PORT=5432
MAIN_DB_DATABASE=foncode
MAIN_DB_USERNAME=postgres
MAIN_DB_PASSWORD=
TEAM_SYNC_SOURCE=main_site
TEAM_SYNC_READONLY=true

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=10080

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_URL="${APP_URL}"
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MEDIA_DISK=private
CORS_ALLOWED_ORIGINS=*

YANDEX_SERVICE_ACCOUNT_API=
YANDEX_FOLDER_ID=

# флаг который разрешает фотовый перевод (если false, то перевода не будет)
YANDEX_AUTO_TRANSLATE=false

# целевые языки перевода, нежелательно их менять, созданы для наглядности
YANDEX_TARGET_LANGUAGES="ru,en,de,fr,es,pt,zh_CN"

# задержка перед переводом обновления, сделано для того чтобы избежать дублирования переводов при многократном обновлении записей
# в течении коротного промежутка времени
YANDEX_TRANSLATE_UPDATE_DELAY=120
